---
const { matomo, plausible, ga4 } = Astro.props;
---
{matomo && (
  <>
    <script>
      var _paq = window._paq = window._paq || [];
      _paq.push(["trackPageView"]); _paq.push(["enableLinkTracking"]);
      (function(){ var u={JSON.stringify(matomo.url)}; _paq.push(["setTrackerUrl", u+"/matomo.php"]);
      _paq.push(["setSiteId", {JSON.stringify(matomo.siteId)}]);
      var d=document, g=d.createElement("script"), s=d.getElementsByTagName("script")[0];
      g.async=true; g.src=u+"/matomo.js"; s.parentNode.insertBefore(g,s); })();
    </script>
  </>
)}
{plausible && (
  <script defer data-domain={plausible.domain} src="https://plausible.io/js/script.js"></script>
)}
{ga4 && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4.id}`}></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date()); gtag('config', {JSON.stringify(ga4.id)});
    </script>
  </>
)}
