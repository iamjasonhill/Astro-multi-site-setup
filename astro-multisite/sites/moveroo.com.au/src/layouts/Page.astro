---
import Layout from '@again/theme-moveroo/components/Layout.astro';
import site from '../config/site';

const {
  title = 'Moveroo',
  description = 'Vehicle & household transport across Australia',
  ogImage
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} siteUrl={site.siteUrl}>
  <slot />
</Layout>
